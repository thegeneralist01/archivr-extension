{
  "name": "archivr-extension",
  "version": "0.1.4",
  "private": true,
  "description": "Chrome extension for capturing pages, X posts and threads, YouTube videos, and selected text to a self-hosted Archivr archive.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thegeneralist01/archivr-extension.git"
  },
  "bugs": {
    "url": "https://github.com/thegeneralist01/archivr-extension/issues"
  },
  "homepage": "https://github.com/thegeneralist01/archivr-extension#readme",
  "type": "module",
  "scripts": {
    "dev": "bun scripts/dev.ts",
    "build": "bun scripts/build.ts",
    "test": "bun test --path-ignore-patterns='tests/x-video-menu.browser.test.ts'",
    "test:browser": "bun run build && bun test tests/x-video-menu.browser.test.ts",
    "test:all": "bun run test && bun run test:browser",
    "test:ui": "bun run build && bun scripts/verify-ui.ts && bun scripts/verify-extension.ts",
    "typecheck": "tsc --noEmit",
    "zip": "bun run build && bun scripts/zip.ts"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.287",
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "playwright": "^1.63.0",
    "typescript": "^5.7.2",
    "vite": "^5.4.11"
  }
}
